# Managed by Ansible - 请勿手工修改
global:
  scrape_interval: {{ prom_interval }}
  evaluation_interval: {{ prom_interval }}

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['alertmanager:9093']

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: cadvisor
    static_configs:
      - targets: ['cadvisor:8080']

  - job_name: node
    static_configs:
      - targets: ['node-exporter:9100']

  - job_name: app
    metrics_path: /metrics.php
    static_configs:
      - targets: ['nginx:80']
